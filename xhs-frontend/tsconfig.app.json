{
  "compilerOptions": {
    "target": "ESNext", // Which JS version to compile to
    "module": "ESNext", // Module system (ESM for Vite)
    "moduleResolution": "bundler", // Let bundlers (like Vite) resolve modules
    "strict": true, // Enable all strict type-checking
    "jsx": "preserve", // Required for JSX/TSX support
    "allowJs": true, // Also process .js files
    "checkJs": false, // But don’t type-check them by default
    "resolveJsonModule": true, // Allow importing JSON
    "isolatedModules": true, // Required for Vite HMR
    "types": ["vite/client"], // Vite global types like import.meta.env
    "baseUrl": ".", // Root for relative paths
    "paths": {
      "@/*": ["src/*"] // Support @/components/Foo style imports
    }
  },
  "include": ["src", "env.d.ts"], // Files/directories to compile
  "exclude": ["node_modules", "dist"]
}
